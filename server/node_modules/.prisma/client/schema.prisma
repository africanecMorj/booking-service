generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String

  roles Role[]

  sessions Session[]

  dashboards Dashboard[]

  dashboardMemberships DashboardMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id String @id @default(uuid())

  userId String

  jti String @unique

  refreshHash String

  userAgent String?

  ip String?

  expiresAt DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([jti])
}

model Dashboard {
  id String @id @default(uuid())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  members DashboardMember[]
  ranges  DashboardRange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DashboardMember {
  dashboardId String
  userId      String

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@id([dashboardId, userId])
  @@index([userId])
}

model DashboardRange {
  id String @id @default(uuid())

  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  from DateTime
  to   DateTime

  createdAt DateTime @default(now())

  @@index([dashboardId])
  @@index([from])
  @@index([to])
}
